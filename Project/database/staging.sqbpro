="0"><sort/><column_widths><column index="1" value="124"/><column index="2" value="88"/><column index="3" value="300"/><column index="4" value="44"/><column index="5" value="39"/><column index="6" value="288"/><column index="7" value="94"/><column index="8" value="129"/><column index="9" value="117"/><column index="10" value="156"/><column index="11" value="143"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="raw_edw_weekly" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="163"/><column index="2" value="65"/><column index="3" value="39"/><column index="4" value="74"/><column index="5" value="84"/><column index="6" value="109"/><column index="7" value="93"/><column index="8" value="156"/><column index="9" value="124"/><column index="10" value="156"/><column index="11" value="143"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="raw_target" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="171"/><column index="2" value="78"/><column index="3" value="132"/><column index="4" value="117"/><column index="5" value="117"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- 1. Membuat data tahun 2025 (Mengcopy 2026, memotong nominal transaksi 20%)
INSERT INTO raw_card_share (MERCHANT_GROUP, TRX_MONTH, TOTAL_SV, TOTAL_FBI, TOTAL_TRX)
SELECT 
    MERCHANT_GROUP, 
    REPLACE(TRX_MONTH, '2026', '2025'), -- Ubah teks 2026 jadi 2025
    TOTAL_SV * 0.80,  -- Sales Volume dipotong jadi 80%
    TOTAL_FBI * 0.80, -- FBI dipotong jadi 80%
    TOTAL_TRX * 0.85  -- Jumlah transaksi dipotong jadi 85%
FROM raw_card_share 
WHERE TRX_MONTH LIKE '2026%';

-- 2. Membuat data tahun 2024 (Mengcopy 2025 yang baru dibuat, memotong lagi 20%)
INSERT INTO raw_card_share (MERCHANT_GROUP, TRX_MONTH, TOTAL_SV, TOTAL_FBI, TOTAL_TRX)
SELECT 
    MERCHANT_GROUP, 
    REPLACE(TRX_MONTH, '2025', '2024'), 
    TOTAL_SV * 0.80,  
    TOTAL_FBI * 0.80, 
    TOTAL_TRX * 0.85  
FROM raw_card_share 
WHERE TRX_MONTH LIKE '2025%';</sql><current_tab id="0"/></tab_sql></sqlb_project>
